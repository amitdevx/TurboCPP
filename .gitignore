# Swap files (inside TC/ and project root)
TC/**/*.SWP
*.SWP

# Build artifacts produced by Turbo C++
!TC/LIB/*.OBJ    # ← CRITICAL: Allow startup files (must be BEFORE *.OBJ)
NONAME*.EXE
NONAME*.OBJ
*.OBJ
*.EXE
!TC/BIN/*.EXE

# Backup files generated by Turbo C++ editor
*.BAK

# User's Projects
TC/Projects/*

# Backup of start.sh
start.sh.backup

# TurboCPP AI
TC/LIB/.data/.engine/config.json
TC/LIB/.data/.engine/.logs/
TC/LIB/.data/.engine/.backups/
TC/LIB/.data/.engine/__pycache__/
TC/LIB/.data/.engine/src/__pycache__/
TC/LIB/.data/.engine/venv/
